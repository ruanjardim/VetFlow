APP_NAME=VetFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=vetflow
# DB_PASSWORD=
DB_SSLMODE=prefer

# Isolated target used only by `vetflow:backup:verify` after an operator import.
# RESTORE_DB_CONNECTION=mysql
# RESTORE_DB_HOST=127.0.0.1
# RESTORE_DB_PORT=3306
# RESTORE_DB_DATABASE=vetflow_restore_drill
# RESTORE_DB_USERNAME=
# RESTORE_DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

VETFLOW_QUEUE_MODE=worker
VETFLOW_QUEUE_CRON_TRANSPORT=http
VETFLOW_QUEUE_CRON_ENABLED=false
VETFLOW_QUEUE_CRON_TOKEN=
VETFLOW_QUEUE_CRON_HEADER=X-Cron-Auth
VETFLOW_QUEUE_CRON_MAX_JOBS=25
VETFLOW_QUEUE_CRON_MAX_TIME=45
VETFLOW_QUEUE_CRON_TIMEOUT=30
VETFLOW_QUEUE_CRON_TRIES=3
VETFLOW_BACKUP_EVIDENCE_MAX_AGE_DAYS=30
VETFLOW_RUNTIME_PROBE_DISK=
VETFLOW_RUNTIME_PROBE_EVIDENCE_MAX_AGE_MINUTES=180
VETFLOW_RELEASE_SHA=

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@vetflow.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

VETFLOW_SEED_DEMO_USER=false
TRUSTED_PROXIES=

PRODUCT_LOOKUP_ENABLED=true
PRODUCT_LOOKUP_TIMEOUT_SECONDS=4
PRODUCT_LOOKUP_CONNECT_TIMEOUT_SECONDS=2
PRODUCT_LOOKUP_ATTEMPTS=2
PRODUCT_LOOKUP_NEGATIVE_CACHE_DAYS=7
PRODUCT_LOOKUP_MAX_IMAGE_BYTES=5242880
PRODUCT_LOOKUP_IMAGE_ALLOWED_HOSTS=images.openfoodfacts.org,static.openfoodfacts.org,images.openpetfoodfacts.org,static.openpetfoodfacts.org,images.openproductsfacts.org,static.openproductsfacts.org,openfoodfacts-images.s3.eu-west-3.amazonaws.com

SALES_OFFLINE_CATALOG_LIMIT=5000

NFE_MAX_XML_BYTES=5242880
NFE_MAX_ITEMS=500
NFE_MAX_LOCAL_XML_FILES=1000
NFE_KEY_LOOKUP_URL=
NFE_KEY_LOOKUP_TOKEN=
NFE_KEY_LOOKUP_TIMEOUT_SECONDS=10
NFE_KEY_LOOKUP_CONNECT_TIMEOUT_SECONDS=3
NFE_KEY_LOOKUP_ATTEMPTS=2
NFE_XML_ARCHIVE_PATH=

# Fiscal provider traffic remains blocked unless a reviewed deployment opts in.
# Certificates stay outside VetFlow. Provider tokens may use the opt-in
# encrypted_database driver for clinic-owned accounts or an external file.
VETFLOW_FISCAL_EXTERNAL_HTTP_ENABLED=false
VETFLOW_FISCAL_SUBMISSION_ENABLED=false
VETFLOW_FISCAL_PROVIDER_ADAPTER=disabled
# Use encrypted_database when each clinic connects and pays for its own Focus account.
VETFLOW_FISCAL_CREDENTIAL_DRIVER=disabled
VETFLOW_FISCAL_CREDENTIAL_FILE=
VETFLOW_FISCAL_CREDENTIAL_MAX_FILE_BYTES=65536
VETFLOW_FISCAL_QUEUE_CONNECTION=database
VETFLOW_FISCAL_QUEUE=fiscal
VETFLOW_FISCAL_AUTOMATIC_RECONCILIATION=true
VETFLOW_FISCAL_PROCESSING_STALE_MINUTES=180
VETFLOW_FISCAL_CANCELLATION_STALE_MINUTES=30
VETFLOW_FISCAL_ALERT_MAX_ITEMS=20
VETFLOW_FISCAL_WEBHOOK_RESEND_COOLDOWN_MINUTES=5
VETFLOW_FISCAL_ARTIFACT_MAX_BYTES=10485760
VETFLOW_FISCAL_ARTIFACT_REDIRECT_HOSTS=
VETFLOW_NFCE_CANCELLATION_WINDOW_MINUTES=30
FOCUS_NFE_HOMOLOGATION_URL=https://homologacao.focusnfe.com.br
FOCUS_NFE_TIMEOUT_SECONDS=15
FOCUS_NFE_CONNECT_TIMEOUT_SECONDS=5
FOCUS_NFE_WEBHOOK_ENABLED=false
FOCUS_NFE_WEBHOOK_AUTHORIZATION_HEADER=X-VetFlow-Focus-Webhook
FOCUS_NFE_WEBHOOK_AUTHORIZATION_TOKEN=
FOCUS_NFE_WEBHOOK_MAX_PAYLOAD_BYTES=131072
